---
import { mappedAsset, nordicAssets } from '../lib/nordic-assets';
interface Props { id: string; name: string; unlocked?: boolean }
const { id, unlocked = false } = Astro.props;
const asset = mappedAsset(nordicAssets.achievements, id);
if (!asset) throw new Error(`Unknown achievement asset: ${id}`);
---
<span class:list={['achievement-badge', `badge-${id}`, { unlocked, locked: !unlocked }]} aria-hidden="true">
  <img src={asset} width="220" height="250" alt="" aria-hidden="true" loading="lazy" decoding="async" />
</span>
