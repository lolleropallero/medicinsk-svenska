---
import AppIcon from './AppIcon.astro';
import { achievementBadge } from '../lib/visuals';
interface Props { id: string; name: string; unlocked?: boolean }
const { id, name, unlocked = false } = Astro.props;
const badge = achievementBadge(id);
---
<span class:list={['achievement-badge', `badge-${id}`, { unlocked, locked: !unlocked }]} role="img" aria-label={`${name}, ${unlocked ? 'upplåst' : 'låst'}`}><span class="badge-core"><AppIcon name={badge.icon} size={32}/><b>{badge.mark}</b></span><span class="badge-ribbon">SV</span></span>
