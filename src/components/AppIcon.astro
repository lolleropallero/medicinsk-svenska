---
import { ICON_PATHS, resolveIcon, type IconName } from '../lib/visuals';
interface Props { name: IconName|string; size?: 24|32; label?: string; class?: string }
const { name, size = 24, label, class: className } = Astro.props;
const icon = resolveIcon(name);
---
<svg class:list={['app-icon', className]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} set:html={ICON_PATHS[icon]}></svg>
