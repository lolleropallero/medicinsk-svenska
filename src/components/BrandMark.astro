---
interface Props { wordmark?: boolean; compact?: boolean }
const { wordmark = false, compact = false } = Astro.props;
---
<span class:list={['brand-lockup', { 'brand-lockup-wordmark': wordmark, compact }]}>
  <svg class="brand-mark" viewBox="0 0 48 42" aria-hidden="true">
    <path class="brand-tile-fi" d="M4 5.5C4 3.6 5.6 2 7.5 2h24C33.4 2 35 3.6 35 5.5v24c0 1.9-1.6 3.5-3.5 3.5h-24A3.5 3.5 0 0 1 4 29.5v-24Z"/>
    <path class="brand-cross-fi" d="M14 2h7v31h-7zM4 13h31v7H4z"/>
    <path class="brand-tile-sv" d="M15 12.5c0-1.9 1.6-3.5 3.5-3.5h24c1.9 0 3.5 1.6 3.5 3.5v24c0 1.9-1.6 3.5-3.5 3.5h-24a3.5 3.5 0 0 1-3.5-3.5v-24Z"/>
    <path class="brand-cross-sv" d="M26 9h7v31h-7zM15 20h31v7H15z"/>
    <path class="brand-pulse" d="M5 28h7l3-6 4 10 4-7 3 3h8"/>
  </svg>
  {wordmark && <span class="brand-name">Medicinsk <span>svenska</span></span>}
</span>
