---
import { visualFixAssets, type RewardBoxKind } from '../lib/visual-fix-assets';
interface Props { kind?: RewardBoxKind; label?: string }
const { kind = 'standard', label } = Astro.props;
---
<span class={`compact-reward-box compact-box-${kind}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <img class="compact-box-image" src={visualFixAssets.rewards.hud} width="96" height="76" alt="" aria-hidden="true" decoding="async" />
</span>
