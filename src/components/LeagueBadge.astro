---
import { leagueBadge } from '../lib/visuals';
interface Props { tier: string; large?: boolean }
const { tier, large = false } = Astro.props;
const badge = leagueBadge(tier);
---
<span class:list={['league-badge', `league-${badge.className}`, { large }]}>
  <img class="league-shield" src={badge.asset} width="240" height="280" alt="" aria-hidden="true" loading="lazy" decoding="async" />
  <strong>{badge.label}</strong>
</span>
