---
import { visualFixAssets, type BackgroundKind } from '../lib/visual-fix-assets';
interface Props { kind: BackgroundKind }
const { kind } = Astro.props;
const background = visualFixAssets.backgrounds[kind];
---
<span class={`nordic-backdrop background-${kind}`} style={`--nordic-background:url("${background}")`} aria-hidden="true"></span>
