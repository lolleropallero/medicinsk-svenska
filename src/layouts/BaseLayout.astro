---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import NordicBackdrop from '../components/NordicBackdrop.astro';
import MobileNavigation from '../components/MobileNavigation.astro';
import AppIcon from '../components/AppIcon.astro';
import { nordicAssets } from '../lib/nordic-assets';
interface Props { title: string; description?: string }
const { title, description = 'Harjoittele lääketieteellistä ruotsia.' } = Astro.props;
const path = Astro.url.pathname;
const hudRoutes=['/','/kortit','/fraasit','/kuvailu','/edistyminen','/palkinnot','/kausi'];
const exerciseRoute=path.includes('/harjoitus');
const showHud=hudRoutes.some(route=>path===route||path===`${route}/`)&&!exerciseRoute;
const rewardRoute=path.startsWith('/palkinnot')||path.startsWith('/kausi');
const backgroundKind=exerciseRoute?'studyLight':rewardRoute?'rewardsDark':path==='/'?'homeDark':'shellLight';
---
<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06162a" />
    <link rel="icon" href={nordicAssets.brand.mark} type="image/svg+xml" />
    <script is:inline>
      try {
        const value = JSON.parse(localStorage.getItem('medicinsk-svenska.progress.v1') || 'null');
        if (value?.inventory?.equipped?.theme) document.documentElement.dataset.theme = value.inventory.equipped.theme;
        if (typeof value?.settings?.calmMode === 'boolean') document.documentElement.dataset.calm = String(value.settings.calmMode);
      } catch {}
    </script>
    <title>{title} · Medicinsk svenska</title>
  </head>
  <body class:list={{ 'home-route': path === '/', 'exercise-route': exerciseRoute, 'metagame-route': rewardRoute }}>
    <a class="skip-link" href="#sisalto">Siirry sisältöön</a>
    <NordicBackdrop kind={backgroundKind}/>
    {!exerciseRoute&&<header class="site-header">
      <a class="brand" href="/" aria-label="Medicinsk svenska, etusivu"><BrandMark wordmark /></a>
      <div class="desktop-navigation" role="navigation" aria-label="Päänavigaatio">
        <a href="/kortit/" aria-current={path.startsWith('/kortit') ? 'page' : undefined}><AppIcon name="flashcards"/>Sanakortit</a>
        <a href="/fraasit/" aria-current={path.startsWith('/fraasit') ? 'page' : undefined}><AppIcon name="phrases"/>Fraasit</a>
        <a href="/kuvailu/" aria-current={path.startsWith('/kuvailu') ? 'page' : undefined}><AppIcon name="descriptions"/>Kuvailu</a>
        <a href="/edistyminen/" lang="sv" aria-current={path.startsWith('/edistyminen') ? 'page' : undefined}><AppIcon name="progress"/>Framsteg</a>
      </div>
      <div class="desktop-metagame" role="navigation" aria-label="Palkinnot ja kausi">
        <a href="/palkinnot/" lang="sv" aria-label="Belöningar" aria-current={path.startsWith('/palkinnot') ? 'page' : undefined}><AppIcon name="gift"/></a>
        <a href="/kausi/" lang="sv" aria-label="Säsong" aria-current={path.startsWith('/kausi') ? 'page' : undefined}><AppIcon name="season"/></a>
      </div>
    </header>}
    {showHud&&<aside id="metagame-hud" class="metagame-hud" aria-label="Spelstatus" lang="sv"></aside>}
    <main id="sisalto" class:list={{ 'study-main': exerciseRoute }}><slot /></main>
    {!exerciseRoute&&<MobileNavigation path={path}/>}
    <div id="reward-notifications" class="notifications" aria-live="polite"></div>
    <div id="music-player" aria-hidden="true"></div>
    <script src="../scripts/progress-shell.ts"></script>
    <script src="../scripts/music-player.ts"></script>
  </body>
</html>
