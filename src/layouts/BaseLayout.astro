---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Harjoittele lääketieteellistä ruotsia.' } = Astro.props;
---
<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f2ec" />
    <title>{title} · Medicinsk svenska</title>
  </head>
  <body>
    <a class="skip-link" href="#sisalto">Siirry sisältöön</a>
    <header class="site-header">
      <a class="brand" href="/">Medicinsk svenska</a>
      <nav aria-label="Päänavigaatio">
        <a href="/kortit">Sanakortit</a>
        <a href="/kuvailu">Kuvailutehtävät</a>
      </nav>
    </header>
    <main id="sisalto"><slot /></main>
    <footer>Itsenäiseen opiskeluun · Edistyminen säilyy vain tällä laitteella</footer>
  </body>
</html>
