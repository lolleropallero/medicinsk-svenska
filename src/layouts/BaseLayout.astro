---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Harjoittele lääketieteellistä ruotsia.' } = Astro.props;
const path = Astro.url.pathname;
const hudRoutes=['/','/kortit','/fraasit','/kuvailu','/edistyminen','/palkinnot','/kausi'];
const showHud=hudRoutes.some(route=>path===route||path===`${route}/`)&&!path.endsWith('/harjoitus');
---
<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f2ec" />
    <script is:inline>
      try {
        const value = JSON.parse(localStorage.getItem('medicinsk-svenska.progress.v1') || 'null');
        if (value?.inventory?.equipped?.theme) document.documentElement.dataset.theme = value.inventory.equipped.theme;
        if (typeof value?.settings?.calmMode === 'boolean') document.documentElement.dataset.calm = String(value.settings.calmMode);
      } catch {}
    </script>
    <title>{title} · Medicinsk svenska</title>
  </head>
  <body class:list={{ 'home-route': path === '/' }}>
    <a class="skip-link" href="#sisalto">Siirry sisältöön</a>
    <header class="site-header">
      <a class="brand" href="/">Medicinsk svenska</a>
      <nav aria-label="Päänavigaatio">
        <a href="/kortit" aria-current={path.startsWith('/kortit') ? 'page' : undefined}>Sanakortit</a>
        <a href="/fraasit" aria-current={path.startsWith('/fraasit') ? 'page' : undefined}>Fraasit</a>
        <a href="/kuvailu" aria-current={path.startsWith('/kuvailu') ? 'page' : undefined}>Kuvailutehtävät</a>
        <a href="/edistyminen" lang="sv" aria-current={path.startsWith('/edistyminen') ? 'page' : undefined}>Framsteg</a>
      </nav>
    </header>
    {showHud&&<aside id="metagame-hud" class="metagame-hud" aria-label="Spelstatus" lang="sv"></aside>}
    <main id="sisalto"><slot /></main>
    <div id="reward-notifications" class="notifications" aria-live="polite"></div>
    <script src="../scripts/progress-shell.ts"></script>
  </body>
</html>
