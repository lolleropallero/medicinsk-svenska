---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppIcon from '../../components/AppIcon.astro';
import FlagRibbon from '../../components/FlagRibbon.astro';
---
<BaseLayout title="Framsteg">
  <div class="page wrap-wide">
    <div class="page-heading"><div class="heading-lockup"><span class="setup-icon"><AppIcon name="progress" size={32}/></span><div><span class="eyebrow">Nordiskt studiepass</span><h1 lang="sv">Framsteg</h1></div><FlagRibbon variant="dual"/></div><div class="section-links" lang="sv"><a href="/palkinnot/"><AppIcon name="gift"/>Belöningar</a><a href="/kausi/"><AppIcon name="season"/>Säsong</a></div></div>
    <div id="progress-dashboard" class="dashboard-grid" aria-live="polite"></div>
    <section class="dashboard-card settings-card"><h2 lang="sv"><AppIcon name="theme"/> Inställningar</h2><div class="settings-grid"><label lang="sv">Dagligt mål<select id="daily-goal"><option>5</option><option>10</option><option>20</option><option>30</option></select></label><label class="toggle" lang="sv"><input id="calm-mode" type="checkbox" /> Lugnt läge</label><label class="toggle" lang="fi"><input id="sound-enabled" type="checkbox" /> Ääniefektit</label><label lang="fi">Äänenvoimakkuus <span><input id="sound-volume" type="range" min="0" max="100" step="1" value="65" /><output id="sound-volume-value" for="sound-volume">65 %</output></span></label><label class="toggle" lang="fi"><input id="music-enabled" type="checkbox" /> Musiikki</label><label lang="fi">Musiikin voimakkuus <span><input id="music-volume" type="range" min="0" max="100" step="1" value="0" /><output id="music-volume-value" for="music-volume">0 %</output></span></label></div><p class="muted" lang="fi">Ääniefektit ja taustamusiikki säädetään erikseen.</p><div class="data-management" lang="fi"><h3>Tietojen hallinta</h3><div class="data-actions"><button id="export-progress">Vie tiedot</button><label class="button secondary file-button">Tuo tiedot<input id="import-progress" type="file" accept="application/json" /></label><button id="reset-progress" class="danger">Nollaa edistyminen</button></div><p id="data-status" role="status" aria-live="polite"></p></div></section>
  </div>
  <script src="../../scripts/progress-ui.ts"></script>
</BaseLayout>
