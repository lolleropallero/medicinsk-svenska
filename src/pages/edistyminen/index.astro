---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Edistyminen">
  <div class="page wrap-wide"><div class="page-heading"><div><p class="eyebrow">Oma harjoittelu</p><h1>Edistyminen</h1></div><div class="section-links"><a href="/palkinnot/">Palkinnot</a><a href="/kausi/">Kausi</a></div></div>
    <div id="progress-dashboard" class="dashboard-grid" aria-live="polite"></div>
    <section class="dashboard-card settings-card"><h2>Asetukset ja tiedot</h2><div class="settings-grid"><label>Päivätavoite<select id="daily-goal"><option>5</option><option>10</option><option>20</option><option>30</option></select></label><label class="toggle"><input id="calm-mode" type="checkbox" /> Rauhallinen tila</label></div><div class="data-actions"><button id="export-progress">Vie tiedot</button><label class="button secondary file-button">Tuo tiedot<input id="import-progress" type="file" accept="application/json" /></label><button id="reset-progress" class="danger">Nollaa edistyminen</button></div><p id="data-status" role="status" aria-live="polite"></p></section>
  </div>
  <script src="../../scripts/progress-ui.ts"></script>
</BaseLayout>
