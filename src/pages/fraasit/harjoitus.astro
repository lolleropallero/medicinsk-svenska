---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppIcon from '../../components/AppIcon.astro';
import FlagRibbon from '../../components/FlagRibbon.astro';
import { phraseCategoryPayload, phrasePayload } from '../../lib/content';
---
<BaseLayout title="Fraasiharjoitus">
  <section class="practice wrap phrase-practice" aria-labelledby="phrase-session-label">
    <div class="practice-top">
      <a class="practice-back" href="/fraasit/"><AppIcon name="back"/>Takaisin</a>
      <strong id="phrase-session-label"></strong>
      <div class="session-status"><span id="phrase-progress" aria-live="polite"></span><time id="phrase-elapsed" aria-label="Kulunut aika 00:00" datetime="PT0S">00:00</time></div>
    </div>
    <div id="phrase-session-view">
      <div class="progress-track" aria-hidden="true"><span id="phrase-progress-bar"></span></div>
      <button id="phrase-card" class="flashcard phrase-card" type="button" aria-label="Näytä vastaus">
        <span class="speech-bubble cue"><span id="phrase-fi" class="term" lang="fi"></span></span>
        <span id="phrase-answer" hidden><span class="answer-bridge" aria-hidden="true"><AppIcon name="arrow"/></span><span class="speech-bubble target"><span id="phrase-sv" class="term answer" lang="sv"></span></span></span>
      </button>
      <div id="phrase-grade-actions" class="action-row" hidden>
        <button class="danger" id="phrase-missed" type="button">En osannut</button>
        <button class="success" id="phrase-correct" type="button">Osasin</button>
      </div>
    </div>
    <div id="phrase-waiting" class="waiting" hidden>
      <span class="waiting-visual" aria-hidden="true"><AppIcon name="retry" size={32}/><i></i></span>
      <h1 id="phrase-waiting-copy" tabindex="-1"></h1>
      <p>Seuraava kertaus <strong id="phrase-retry-countdown"></strong></p>
      <a href="/fraasit">Takaisin fraaseihin</a>
    </div>
    <div id="phrase-summary" class="summary" hidden>
      <FlagRibbon variant="dual" />
      <h1 id="phrase-summary-title" tabindex="-1">Valmis</h1>
      <dl class="summary-stats">
        <div><dt>Ensimmäisellä</dt><dd id="phrase-summary-first"></dd></div>
        <div><dt>Virheitä</dt><dd id="phrase-summary-missed"></dd></div>
        <div><dt>Aika</dt><dd><time id="phrase-summary-time"></time></dd></div>
      </dl>
      <div id="phrase-rewards" class="session-rewards" hidden></div>
      <div class="summary-actions">
        <button class="primary" id="phrase-new-round" type="button">Uusi kierros</button>
        <a class="button secondary" href="/fraasit">Takaisin fraaseihin</a>
      </div>
    </div>
    <div id="phrase-error" class="error-state" hidden>
      <h1 id="phrase-error-title" tabindex="-1">Harjoitusta ei löytynyt</h1>
      <a class="button secondary" href="/fraasit">Takaisin fraaseihin</a>
    </div>
  </section>
  <script is:inline id="phrases-data" type="application/json" set:html={JSON.stringify(phrasePayload)}></script>
  <script is:inline id="phrase-categories-data" type="application/json" set:html={JSON.stringify(phraseCategoryPayload)}></script>
  <script src="../../scripts/phrase-app.ts"></script>
</BaseLayout>
