---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppIcon from '../../components/AppIcon.astro';
import FlagRibbon from '../../components/FlagRibbon.astro';
import { phraseCategoryPayload, publishedPhrases } from '../../lib/content';
const counts = Object.fromEntries(phraseCategoryPayload.map((category) => [
  category.id, publishedPhrases.filter((phrase) => phrase.categoryId === category.id).length,
]));
---
<BaseLayout title="Vastaanottofraasit">
  <section class="page wrap phrase-setup" aria-labelledby="page-title">
    <header class="setup-heading"><span class="setup-icon"><AppIcon name="phrases" size={32}/></span><div><span class="eyebrow">Kliininen keskustelu</span><h1 id="page-title">Vastaanottofraasit</h1></div><FlagRibbon variant="dual"/></header>
    <fieldset class="amount-selector">
      <legend>Fraasien määrä</legend>
      <div class="segments segments-three">
        <label><input type="radio" name="phrase-amount" value="10" checked /><span>10</span></label>
        <label><input type="radio" name="phrase-amount" value="25" /><span>25</span></label>
        <label><input type="radio" name="phrase-amount" value="all" /><span>Kaikki</span></label>
      </div>
    </fieldset>
    <a class="all-topics" data-phrase-start data-mode="all" href="/fraasit/harjoitus?mode=all&amount=10">
      <span class="row-icon"><AppIcon name="phrases" size={32}/></span><span><strong>Kaikki fraasit</strong><small>Suomenkielinen vihje, ruotsinkielinen vastaus</small></span><span>{publishedPhrases.length} fraasia</span><AppIcon name="arrow"/>
    </a>
    <div class="category-list">
      {phraseCategoryPayload.map((category) => (
        <a class="category-row" data-phrase-start data-mode="category" data-category={category.id}
          href={`/fraasit/harjoitus?mode=category&category=${category.id}&amount=10`}>
          <span class="row-icon"><AppIcon name={category.id==='oireet-vointi'?'heartLungs':'phrases'} size={32}/></span><h2>{category.nameFi}</h2><span class="category-count">{counts[category.id]} fraasia</span><span class="category-start">Aloita <AppIcon name="arrow"/></span>
        </a>
      ))}
    </div>
  </section>
  <script src="../../scripts/phrase-setup.ts"></script>
</BaseLayout>
