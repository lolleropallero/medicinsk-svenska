---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedCards, publishedDecks } from '../../lib/content';
---
<BaseLayout title="Korttiharjoitus">
  <section class="practice wrap" id="flashcard-app" aria-labelledby="session-label">
    <div class="practice-top">
      <a href="/kortit">Takaisin</a>
      <strong id="session-label"></strong>
      <div class="session-status"><span id="progress" aria-live="polite"></span><time id="elapsed-time">0:00</time></div>
    </div>
    <div id="session-view">
      <div class="progress-track" aria-hidden="true"><span id="progress-bar"></span></div>
      <button id="flashcard" class="flashcard" type="button" aria-label="Näytä vastaus">
        <span id="front-term" class="term"></span>
        <span id="answer-area" hidden><span class="divider"></span><span id="back-term" class="term answer"></span><span id="grammar"></span></span>
      </button>
      <div id="grade-actions" class="action-row" hidden><button class="danger" id="missed" aria-keyshortcuts="2" title="Pikanäppäin: 2">En osannut</button><button class="success" id="correct" aria-keyshortcuts="1" title="Pikanäppäin: 1">Osasin</button></div>
    </div>
    <div id="waiting-view" class="waiting" hidden aria-live="polite">
      <p id="waiting-copy"></p>
      <p>Seuraava kertaus <strong id="retry-countdown"></strong></p>
    </div>
    <div id="summary-view" class="summary" hidden aria-live="polite">
      <h1>Harjoitus valmis</h1>
      <p id="summary-copy"></p>
      <p id="summary-details"></p>
      <div class="summary-actions"><a class="button primary" href="/kortit">Takaisin pakkoihin</a></div>
    </div>
  </section>
  <script is:inline id="cards-data" type="application/json" set:html={JSON.stringify(publishedCards)}></script>
  <script is:inline id="decks-data" type="application/json" set:html={JSON.stringify(publishedDecks)}></script>
  <script src="../../scripts/flashcard-app.ts"></script>
</BaseLayout>
