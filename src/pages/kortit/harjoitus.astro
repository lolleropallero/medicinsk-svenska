---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedCards, publishedDecks } from '../../lib/content';
---
<BaseLayout title="Korttiharjoitus">
  <section class="practice wrap" id="flashcard-app" aria-labelledby="session-label">
    <div class="practice-top"><a href="/kortit">Takaisin</a><strong id="session-label"></strong><p id="progress" aria-live="polite"></p></div>
    <div id="session-view">
      <div class="progress-track" aria-hidden="true"><span id="progress-bar"></span></div>
      <article class="flashcard" aria-live="polite">
        <p id="side-label"></p><div id="front-term" class="term"></div>
        <div id="answer-area" hidden><div class="divider"></div><p id="answer-label"></p><div id="back-term" class="term answer"></div><p id="grammar"></p></div>
      </article>
      <div id="reveal-actions" class="action-row"><button class="primary" id="reveal" aria-keyshortcuts="Space" title="Pikanäppäin: välilyönti">Näytä vastaus</button></div>
      <div id="grade-actions" class="action-row" hidden><button class="danger" id="missed" aria-keyshortcuts="2" title="Pikanäppäin: 2">En osannut</button><button class="success" id="correct" aria-keyshortcuts="1" title="Pikanäppäin: 1">Osasin</button></div>
      <div id="next-actions" class="action-row" hidden><button class="primary" id="next" aria-keyshortcuts="Enter" title="Pikanäppäin: Enter">Seuraava</button></div>
    </div>
    <div id="summary-view" class="summary" hidden aria-live="polite">
      <h1 id="summary-copy"></h1>
      <div class="summary-actions"><button id="retry" class="primary">Harjoittele virheet uudelleen</button><a class="button secondary" href="/kortit">Takaisin pakkoihin</a></div>
    </div>
  </section>
  <script is:inline id="cards-data" type="application/json" set:html={JSON.stringify(publishedCards)}></script>
  <script is:inline id="decks-data" type="application/json" set:html={JSON.stringify(publishedDecks)}></script>
  <script src="../../scripts/flashcard-app.ts"></script>
</BaseLayout>
