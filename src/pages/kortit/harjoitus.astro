---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppIcon from '../../components/AppIcon.astro';
import LanguageRibbon from '../../components/LanguageRibbon.astro';
import FlagRibbon from '../../components/FlagRibbon.astro';
import { deckPayload, flashcardPayload } from '../../lib/content';
---
<BaseLayout title="Korttiharjoitus">
  <section class="practice wrap" id="flashcard-app" aria-labelledby="session-label">
    <div class="practice-top">
      <a class="practice-back" href="/kortit/"><AppIcon name="back"/>Takaisin</a>
      <strong id="session-label"></strong>
      <div class="session-status"><span id="progress" aria-live="polite"></span><time id="elapsed-time" aria-label="Kulunut aika 00:00" datetime="PT0S">00:00</time></div>
    </div>
    <div id="session-view">
      <div class="progress-track" aria-hidden="true"><span id="progress-bar"></span></div>
      <button id="flashcard" class="flashcard" type="button" aria-label="Näytä vastaus">
        <LanguageRibbon id="source-ribbon" language="fi" />
        <span id="front-term" class="term"></span>
        <span id="answer-area" hidden><span class="answer-bridge" aria-hidden="true"><AppIcon name="arrow"/></span><LanguageRibbon id="target-ribbon" language="sv" /><span id="back-term" class="term answer"></span><span id="grammar"></span></span>
      </button>
      <div id="grade-actions" class="action-row" hidden><button class="danger" id="missed" aria-keyshortcuts="2" title="Pikanäppäin: 2">En osannut</button><button class="success" id="correct" aria-keyshortcuts="1" title="Pikanäppäin: 1">Osasin</button></div>
    </div>
    <div id="waiting-view" class="waiting" hidden>
      <span class="waiting-visual" aria-hidden="true"><AppIcon name="retry" size={32}/><i></i></span>
      <h1 id="waiting-copy" tabindex="-1"></h1>
      <p>Seuraava kertaus <strong id="retry-countdown"></strong></p>
      <a href="/kortit">Takaisin pakkoihin</a>
    </div>
    <div id="summary-view" class="summary" hidden aria-live="polite">
      <FlagRibbon variant="dual" />
      <h1 id="summary-title" tabindex="-1">Valmis</h1>
      <dl class="summary-stats">
        <div><dt>Ensimmäisellä</dt><dd id="summary-first"></dd></div>
        <div><dt>Virheitä</dt><dd id="summary-missed"></dd></div>
        <div><dt>Aika</dt><dd><time id="summary-time"></time></dd></div>
      </dl>
      <div id="flashcard-rewards" class="session-rewards" hidden></div>
      <div class="summary-actions">
        <button class="primary" id="new-round" type="button">Uusi kierros</button>
        <a class="button secondary" href="/kortit">Takaisin pakkoihin</a>
      </div>
    </div>
    <div id="error-view" class="error-state" hidden>
      <h1 id="error-title" tabindex="-1">Pakkaa ei löytynyt</h1>
      <a class="button secondary" href="/kortit">Takaisin pakkoihin</a>
    </div>
  </section>
  <script is:inline id="cards-data" type="application/json" set:html={JSON.stringify(flashcardPayload)}></script>
  <script is:inline id="decks-data" type="application/json" set:html={JSON.stringify(deckPayload)}></script>
  <script src="../../scripts/flashcard-app.ts"></script>
</BaseLayout>
