---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedCards, publishedDecks } from '../../lib/content';
const counts = Object.fromEntries(publishedDecks.map((d) => [d.id, publishedCards.filter((c) => c.deckId === d.id).length]));
---
<BaseLayout title="Sanakortit">
  <section class="page wrap study-setup" aria-labelledby="page-title">
    <h1 id="page-title">Sanakortit</h1>
    <fieldset class="direction direction-selector" id="direction-fieldset">
      <legend class="sr-only">Harjoittelusuunta</legend>
      <div class="segments segments-two">
        <label><input type="radio" name="direction" value="fi-sv" checked /><span>Suomi → ruotsi</span></label>
        <label><input type="radio" name="direction" value="sv-fi" /><span>Ruotsi → suomi</span></label>
      </div>
    </fieldset>
    <fieldset class="amount-selector">
      <legend>Korttien määrä</legend>
      <div class="segments">
        <label><input type="radio" name="amount" value="10" /><span>10</span></label>
        <label><input type="radio" name="amount" value="25" checked /><span>25</span></label>
        <label><input type="radio" name="amount" value="50" /><span>50</span></label>
        <label><input type="radio" name="amount" value="all" /><span>Kaikki</span></label>
      </div>
    </fieldset>
    <a class="lucky" data-start data-mode="lucky" href="/kortit/harjoitus?mode=lucky&direction=fi-sv&amount=25">
      <strong>Kokeilen onneani</strong><span data-selected-count>25 korttia</span>
    </a>
    <div class="deck-list">
      {publishedDecks.map((deck) => (
        <a
          class="deck-row"
          data-start
          data-mode="deck"
          data-deck={deck.id}
          href={`/kortit/harjoitus?mode=deck&deck=${deck.id}&direction=fi-sv&amount=25`}
        >
          <h2>{deck.nameFi}</h2>
          <span class="deck-count">{counts[deck.id]} korttia</span>
          <span class="deck-start">Aloita</span>
        </a>
      ))}
    </div>
  </section>
  <script src="../../scripts/deck-list.ts"></script>
</BaseLayout>
