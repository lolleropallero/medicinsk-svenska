---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishedDescriptions } from '../lib/content';
---
<BaseLayout title="Kuvailutehtävät">
  <section class="practice description-practice wrap" id="description-app" aria-labelledby="description-title">
    <div class="practice-top"><a href="/">Takaisin</a><h1 id="description-title">Kuvailutehtävät</h1><p id="description-progress" aria-live="polite"></p></div>
    <div id="description-session">
      <div class="progress-track" aria-hidden="true"><span id="description-progress-bar"></span></div>
      <article class="description-card"><p id="description-text" lang="sv"></p></article>
      <form id="answer-form">
        <label for="answer">Vastauksesi</label>
        <input id="answer" name="answer" lang="sv" autocomplete="off" autocapitalize="none" />
        <div class="action-row"><button class="primary" type="submit">Tarkista</button><button class="secondary" id="show-answer" type="button">Näytä vastaus</button></div>
      </form>
      <div id="description-feedback" class="feedback" hidden aria-live="polite" role="status">
        <p id="result-label"></p><p>Oikea vastaus: <strong id="canonical-answer" lang="sv"></strong></p>
        <button id="description-next" class="primary">Seuraava</button>
      </div>
    </div>
    <div id="description-summary" class="summary" hidden aria-live="polite">
      <h1>Harjoitus valmis</h1><p id="description-summary-copy"></p>
      <div class="summary-actions"><button id="description-retry" class="primary">Harjoittele virheet uudelleen</button><a class="button secondary" href="/">Takaisin</a></div>
    </div>
  </section>
  <script is:inline id="descriptions-data" type="application/json" set:html={JSON.stringify(publishedDescriptions)}></script>
  <script src="../scripts/description-app.ts"></script>
</BaseLayout>
