---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppIcon from '../../components/AppIcon.astro';
import CompactRewardBox from '../../components/CompactRewardBox.astro';
import FlagRibbon from '../../components/FlagRibbon.astro';
---
<BaseLayout title="Belöningar">
  <div class="page wrap-wide rewards-page"><div class="page-heading"><div class="heading-lockup"><span class="setup-icon"><AppIcon name="gift" size={32}/></span><div><span class="eyebrow">Samla · välj · belönas</span><h1 lang="sv">Belöningar</h1></div><FlagRibbon variant="dual"/></div><div class="section-links" lang="sv"><a href="/edistyminen/"><AppIcon name="progress"/>Framsteg</a><a href="/kausi/"><AppIcon name="season"/>Säsong</a></div></div><nav class="reward-tabs" aria-label="Belöningsinnehåll" lang="sv"><a href="#unopened-boxes"><CompactRewardBox kind="standard"/>Lådor</a><a href="#daily-shop"><AppIcon name="shop"/>Butik</a><a href="#collection"><AppIcon name="collection"/>Samling</a></nav><div id="rewards-dashboard" class="dashboard-grid"></div></div>
  <dialog id="capsule-dialog" class="capsule-dialog" aria-labelledby="capsule-title" lang="sv"><button class="icon-button capsule-skip" data-close aria-label="Hoppa över belöningsanimation"><AppIcon name="close"/></button><div class="capsule-stage" aria-hidden="true"><span class="reveal-mark"><CompactRewardBox kind="standard"/></span></div><p id="capsule-rarity" class="eyebrow"></p><h2 id="capsule-title">Din belöning</h2><strong id="capsule-reward"></strong><button class="primary" data-close>Stäng</button></dialog>
  <script src="../../scripts/progress-ui.ts"></script>
</BaseLayout>
