---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppIcon from '../../../components/AppIcon.astro';
import { examTestTerms } from '../../../lib/exam-test-content';
---
<BaseLayout title="Tee tentti">
  <section class="practice exam-test wrap" id="exam-test-app" aria-labelledby="exam-test-title">
    <div class="practice-top">
      <a class="practice-back" href="/tentti/"><AppIcon name="back"/>Takaisin</a>
      <strong id="exam-test-title">Sanastotentti</strong>
      <div class="session-status"><span id="exam-test-progress" aria-live="polite"></span><time id="exam-test-time" datetime="PT0S" aria-label="Kulunut aika 00:00">00:00</time></div>
    </div>
    <div id="exam-test-question-view">
      <div class="progress-track" aria-hidden="true"><span id="exam-test-progress-bar"></span></div>
      <h1 id="exam-test-direction" tabindex="-1">Kirjoita ruotsiksi</h1>
      <p id="exam-test-instructions" class="setup-note">Termi 1 p + taivutusluokka 1 p. Esimerkki: ett barn 5.</p>
      <article class="answer-card exam-test-card"><p id="exam-test-prompt" class="term"></p></article>
      <form id="exam-test-form" class="answer-exercise" autocomplete="off">
        <label for="exam-test-answer">Vastauksesi</label>
        <input id="exam-test-answer" name="answer" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="500" enterkeyhint="next" aria-describedby="exam-test-instructions"/>
        <div class="action-row">
          <button id="exam-test-previous" class="secondary" type="button" hidden>Edellinen</button>
          <button id="exam-test-next" class="primary" type="submit">Seuraava</button>
        </div>
      </form>
      <p class="setup-note">Vastaukset tarkistetaan, kun palautat kaikki 50 tehtävää. Voit palata muokkaamaan aiempia vastauksia.</p>
    </div>
    <section id="exam-test-summary" class="summary" hidden aria-labelledby="exam-test-summary-title">
      <h1 id="exam-test-summary-title" tabindex="-1">Tentti valmis</h1>
      <dl class="summary-stats">
        <div><dt>Pisteet yhteensä</dt><dd id="exam-test-total"></dd></div>
        <div><dt>Ruotsin osio</dt><dd id="exam-test-swedish"></dd></div>
        <div><dt>Suomen osio</dt><dd id="exam-test-finnish"></dd></div>
      </dl>
      <p>Kulunut aika: <time id="exam-test-summary-time"></time></p>
      <div class="summary-actions"><button id="exam-test-new" class="primary" type="button">Tee uusi tentti</button><a class="button secondary" href="/tentti/">Takaisin tenttisanastoon</a></div>
      <h2>Vastausten tarkistus</h2>
      <label class="exam-test-filter"><input id="exam-test-errors-only" type="checkbox"/>Näytä vain virheet</label>
      <ol id="exam-test-results" class="exam-test-results"></ol>
    </section>
    <div id="exam-test-error" class="error-state" hidden><h1 id="exam-test-error-title" tabindex="-1">Tenttiä ei löytynyt</h1><a class="button secondary" href="/tentti/">Takaisin tenttisanastoon</a></div>
  </section>
  <script is:inline id="exam-test-data" type="application/json" set:html={JSON.stringify(examTestTerms).replace(/</gu, '\\u003c')}></script>
  <script src="../../../scripts/exam-test-app.ts"></script>
</BaseLayout>
