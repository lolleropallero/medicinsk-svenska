---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppIcon from '../../components/AppIcon.astro';
import FlagRibbon from '../../components/FlagRibbon.astro';
import { clinicalScenarioCategoryPayload, clinicalScenarioPayload } from '../../lib/content';
---
<BaseLayout title="Kliininen tilanne">
  <section class="practice wrap clinical-practice" aria-labelledby="clinical-session-label">
    <div class="practice-top">
      <a class="practice-back" href="/tilanteet/"><AppIcon name="back"/>Takaisin</a>
      <strong id="clinical-session-label"></strong>
      <div class="session-status"><span id="clinical-progress" aria-live="polite"></span><time id="clinical-elapsed" aria-label="Kulunut aika 00:00" datetime="PT0S">00:00</time></div>
    </div>
    <div id="clinical-session-view">
      <div class="progress-track" aria-hidden="true"><span id="clinical-progress-bar"></span></div>
      <header class="clinical-scenario-head">
        <p class="eyebrow" id="clinical-step-position"></p>
        <h1 id="clinical-scenario-title" tabindex="-1"></h1>
        <p id="clinical-scenario-context" lang="fi"></p>
      </header>
      <div id="clinical-transcript" class="clinical-transcript"></div>
      <p id="clinical-prompt" class="clinical-instruction" lang="fi"></p>
      <div id="clinical-options" class="choice-options clinical-options" role="group" aria-label="Vastausvaihtoehdot"></div>
      <div id="clinical-feedback" class="clinical-feedback" hidden>
        <p id="clinical-feedback-label" class="feedback-label" aria-live="polite"></p>
        <p id="clinical-feedback-explanation" class="feedback-explanation" lang="fi" hidden></p>
        <div id="clinical-resolution" class="clinical-resolution" hidden>
          <span class="speech-bubble"><span id="clinical-resolution-sv" lang="sv"></span></span>
          <p id="clinical-resolution-fi" lang="fi"></p>
        </div>
        <button id="clinical-continue" class="primary" type="button"></button>
      </div>
    </div>
    <div id="clinical-summary" class="summary" hidden>
      <FlagRibbon variant="dual" />
      <h1 id="clinical-summary-title" tabindex="-1">Valmis</h1>
      <dl class="summary-stats">
        <div><dt>Sujuvat tilanteet</dt><dd id="clinical-summary-flawless"></dd></div>
        <div><dt>Oikein vaiheista</dt><dd id="clinical-summary-steps"></dd></div>
        <div><dt>Aika</dt><dd><time id="clinical-summary-time"></time></dd></div>
      </dl>
      <div id="clinical-rewards" class="session-rewards" hidden></div>
      <div class="summary-actions">
        <button class="primary" id="clinical-new-round" type="button">Uusi kierros</button>
        <a class="button secondary" href="/tilanteet">Takaisin tilanteisiin</a>
      </div>
    </div>
    <div id="clinical-error" class="error-state" hidden>
      <h1 id="clinical-error-title" tabindex="-1">Tilannetta ei löytynyt</h1>
      <a class="button secondary" href="/tilanteet">Takaisin tilanteisiin</a>
    </div>
  </section>
  <script is:inline id="clinical-scenarios-data" type="application/json" set:html={JSON.stringify(clinicalScenarioPayload)}></script>
  <script is:inline id="clinical-categories-data" type="application/json" set:html={JSON.stringify(clinicalScenarioCategoryPayload)}></script>
  <script src="../../scripts/clinical-app.ts"></script>
</BaseLayout>
