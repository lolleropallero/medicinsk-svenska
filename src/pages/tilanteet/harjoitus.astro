---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppIcon from '../../components/AppIcon.astro';
import FlagRibbon from '../../components/FlagRibbon.astro';
import { anamnesisCasePayload } from '../../lib/content';
---
<BaseLayout title="Kliininen tilanne">
  <section class="practice wrap clinical-practice" aria-labelledby="clinical-session-label">
    <div class="practice-top">
      <a class="practice-back" href="/tilanteet/"><AppIcon name="back"/>Takaisin</a>
      <strong id="clinical-session-label"></strong>
      <div class="session-status"><span id="clinical-progress" aria-live="polite"></span><time id="clinical-elapsed" aria-label="Kulunut aika 00:00" datetime="PT0S">00:00</time></div>
    </div>
    <div id="clinical-session-view">
      <div class="progress-track" aria-hidden="true"><span id="clinical-progress-bar"></span></div>
      <header class="clinical-scenario-head">
        <p class="eyebrow" id="anamnesis-section-position" tabindex="-1"></p>
      </header>
      <div class="clinical-transcript" id="clinical-transcript"></div>
      <p class="clinical-instruction" id="anamnesis-instruction" lang="fi">Mitä kysyt potilaalta?</p>

      <form id="anamnesis-form">
        <label class="sr-only" for="anamnesis-input">Kirjoita kysymyksesi ruotsiksi</label>
        <input id="anamnesis-input" type="text" lang="sv" autocomplete="off" autocapitalize="none" spellcheck="false" enterkeyhint="done" />
        <div class="action-row"><button class="primary" id="anamnesis-reveal" type="submit">Näytä mallikysymys</button></div>
      </form>

      <div id="anamnesis-actions" class="action-row" hidden>
        <button class="danger" id="anamnesis-did-not-know" type="button">En osannut</button>
        <button class="success" id="anamnesis-knew" type="button">Osasin</button>
        <button class="primary" id="anamnesis-continue" type="button" hidden>Jatka</button>
      </div>
    </div>
    <div id="clinical-summary" class="summary" hidden>
      <FlagRibbon variant="dual" />
      <h1 id="clinical-summary-title" tabindex="-1">Valmis</h1>
      <dl class="summary-stats">
        <div><dt>Osasit</dt><dd id="clinical-summary-knew"></dd></div>
        <div><dt>Et osannut</dt><dd id="clinical-summary-missed"></dd></div>
        <div><dt>Aika</dt><dd><time id="clinical-summary-time"></time></dd></div>
      </dl>
      <div id="clinical-rewards" class="session-rewards" hidden></div>
      <div class="summary-actions">
        <button class="primary" id="clinical-new-round" type="button">Uusi kierros</button>
        <a class="button secondary" href="/tilanteet">Takaisin tilanteisiin</a>
      </div>
    </div>
    <div id="clinical-error" class="error-state" hidden>
      <h1 id="clinical-error-title" tabindex="-1">Tilannetta ei löytynyt</h1>
      <a class="button secondary" href="/tilanteet">Takaisin tilanteisiin</a>
    </div>
  </section>
  <script is:inline id="anamnesis-cases-data" type="application/json" set:html={JSON.stringify(anamnesisCasePayload)}></script>
  <script src="../../scripts/anamnesis-app.ts"></script>
</BaseLayout>
