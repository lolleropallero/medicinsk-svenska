---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppIcon from '../../components/AppIcon.astro';
import FlagRibbon from '../../components/FlagRibbon.astro';
import { anamnesisCasePayload } from '../../lib/content';
const cases = anamnesisCasePayload.map((item) => ({
  id: item.id,
  nameFi: item.nameFi,
  sectionCount: item.sections.length,
  itemCount: item.sections.reduce((total, section) => total + section.items.length, 0),
}));
---
<BaseLayout title="Kliiniset tilanteet">
  <section class="page wrap clinical-setup" aria-labelledby="page-title">
    <header class="setup-heading"><span class="setup-icon"><AppIcon name="dialogue" size={32}/></span><div><span class="eyebrow">Kliininen keskustelu</span><h1 id="page-title">Kliiniset tilanteet</h1></div><FlagRibbon variant="dual"/></header>
    <p lang="fi">Rakenna anamneesi vaihe vaiheelta: lue potilaan vastaus, kirjoita oma kysymyksesi ruotsiksi ja vertaa sitä mallikysymykseen.</p>
    <div class="category-list">
      {cases.map((item) => (
        <a class="category-row" href={`/tilanteet/harjoitus?case=${item.id}`}>
          <span class="row-icon"><AppIcon name="dialogue" size={32}/></span><h2>{item.nameFi}</h2><span class="category-count">{item.itemCount} kysymystä · {item.sectionCount} osiota</span><span class="category-start">Aloita <AppIcon name="arrow"/></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
